###############################################################################
### REQUIRED ENVIRONMENT VARIABLES - copy this file to `.env` and fill in    ###
### DO NOT commit your real `.env` — it is gitignored.                       ###
###############################################################################

# Ethereum private key used by the CRE CLI to broadcast transactions.
# You can also use a 1Password reference, e.g. op://vault/item/field
CRE_ETH_PRIVATE_KEY=your-eth-private-key

# Default target used when --target is not specified on CRE CLI commands.
# Options: staging-settings, production-settings, or a custom target.
CRE_TARGET=staging-settings
